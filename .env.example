# ==============================================================================
# Dam Break Decision Support System - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development or production configuration.
# SECURITY NOTE: Never commit real API secrets, private keys, or tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API & Network Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Runtime Storage Directory
# ------------------------------------------------------------------------------
# Isolated directory for scenario metadata JSONs, model packages, and run logs.
# Must be an ignored local directory (never tracked in git).
SIH_RUNTIME_DIR=data/runtime

# ------------------------------------------------------------------------------
# 3. Delft3D Flexible Mesh (SWE) Execution Gating
# ------------------------------------------------------------------------------
# Gated execution policy: keep 'false' until a certified D-Flow FM engine binary
# and calibrated physical inputs (topography, roughness, breach hydrographs) are present.
ENABLE_DFLOWFM_EXECUTION=false

# Full absolute path to the local D-Flow FM / DIMR executable
# Example (Windows): DFLOWFM_EXECUTABLE=C:\Deltares\dflowfm\bin\dflowfm.exe
# Example (Linux):   DFLOWFM_EXECUTABLE=/opt/delft3dfm/bin/dflowfm
DFLOWFM_EXECUTABLE=

# ------------------------------------------------------------------------------
# 4. Smoothed Particle Hydrodynamics (PySPH) Execution Gating
# ------------------------------------------------------------------------------
# Gated execution policy: keep 'false' until PySPH environment is installed
# and configured for laboratory-scale 2D benchmark verification.
ENABLE_PYSPH_EXECUTION=false

# Full absolute path to the Python executable in the 'sih-pysph' conda environment
# Example (Windows): PYSPH_PYTHON_PATH=C:\Users\<user>\miniforge3\envs\sih-pysph\python.exe
# Example (Linux):   PYSPH_PYTHON_PATH=/home/<user>/miniforge3/envs/sih-pysph/bin/python
PYSPH_PYTHON_PATH=

# ------------------------------------------------------------------------------
# 5. Google Earth Engine (GEE) Connector & Cloud Export Tasks
# ------------------------------------------------------------------------------
# Google Cloud Project ID configured with Earth Engine API access
# Run 'earthengine authenticate' via Google Cloud CLI before querying.
GEE_PROJECT_ID=

# Gated cloud task submission: keep 'false' to prevent unintended cloud compute costs.
ENABLE_GEE_TASKS=false
